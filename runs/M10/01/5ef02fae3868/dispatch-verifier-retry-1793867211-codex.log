                "-c",
                "user.email=v@example.invalid",
                "-c",
                "user.name=v",
                "commit",
                "-qm",
                "env",
                cwd=manifest.parent,
            ).returncode
            == 0
        )
        assert run(manifest, root / "c").returncode == 4
        text = manifest.read_text().replace(

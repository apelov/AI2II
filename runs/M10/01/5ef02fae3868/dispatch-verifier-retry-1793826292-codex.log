+        sandbox = tmp / "repo"
+        shutil.copytree(
+            ROOT,
+            sandbox,
+            ignore=shutil.ignore_patterns(".git", "__pycache__", ".pytest_cache"),
+        )
+        assert command("git", "init", "-q", cwd=sandbox).returncode == 0
+        assert command("git", "add", "-A", cwd=sandbox).returncode == 0
+        assert command("git", "-c", "user.email=v@example.invalid", "-c", "user.name=v", "commit", "-qm", "snapshot", cwd=sandbox).returncode == 0
+        for source in (sandbox / "wire/example/udp_echo", sandbox / "wire/example/tls_echo"):

+            "set +e; PYTHONPATH=/repo python3 -m wire run interop.yaml --cell echo --out /work/blocked; "
+            "test $? -eq 3"
+        )
+        r = command(
+            "docker",
+            "run",
+            "--rm",
+            "--network",
+            "host",

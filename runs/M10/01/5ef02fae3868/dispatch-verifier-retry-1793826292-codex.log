            "checker-observes-echo.log",
            "checker-vector.log",
            "verdict.json",
            "SHA256SUMS",
        ):
            assert (b / name).is_file(), name
        assert verdict_of(out)["verdict"] == "PASS"
        assert (b / "inputs" / "vectors" / "payload.bin").is_file()
        env = json.loads((b / "env.json").read_text())
